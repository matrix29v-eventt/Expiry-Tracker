# ExpiryTracker Docker Environment Variables
# Copy this file to .env and fill in your values

# Database Configuration (MongoDB Atlas - Online)
MONGO_URI=mongodb+srv://youruser:yourpassword@cluster0.xxxxx.mongodb.net/expirytracker?retryWrites=true&w=majority
MONGO_USERNAME=youruser

# JWT Configuration  
JWT_SECRET=your_super_secure_jwt_secret_minimum_32_characters

# Backend Configuration
PORT=5000
NODE_ENV=production
FRONTEND_URL=http://localhost:3000

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:5000
NEXT_PUBLIC_ENVIRONMENT=production

# Optional: Custom ports
BACKEND_PORT=5000
FRONTEND_PORT=3000
MONGODB_PORT=27017